# Rental PostgreSQL (Docker Compose)
POSTGRES_USER=rental_admin
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=student_rental_db

# Airflow metadata PostgreSQL and application secrets
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace-with-a-local-password
AIRFLOW_JWT_SECRET=replace-with-a-random-secret
AIRFLOW_FERNET_KEY=replace-with-a-valid-fernet-key
AIRFLOW_INTERNAL_API_SECRET_KEY=replace-with-a-random-secret

# Optional localhost ports and scheduler network
RENTAL_POSTGRES_HOST_PORT=5433
AIRFLOW_WEB_PORT=8080
RENTAL_NETWORK_NAME=student-rental-intelligence_default
